# ------------------------------------------------------------------
# xyz-corp-accounts / xyz-corp-accounts — local environment
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# ------------------------------------------------------------------

# --- CodeIgniter ---
CI_ENV=development
APP_BASE_URL=http://localhost:8080/
APP_ENCRYPTION_KEY=change-me-to-a-32-char-random-string
APP_SESS_SAVE_PATH=/tmp

# --- Database (application connection) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=xyz_corp_db

# Fallback credentials used by every connection group.
# For local testing a single MySQL account is enough.
DB_USER=xyz_user
DB_PASSWORD=xyz_password

# --- Database (container root, used by the mysql image on first boot) ---
MYSQL_ROOT_PASSWORD=root_password

# --- Optional per-group overrides (original multi-tenant design) ---
# The login row's `db_user` selects one of these groups. Leave unset
# to fall back to DB_USER / DB_PASSWORD above.
#DB_DEFAULT_USER=
#DB_DEFAULT_PASSWORD=
#DB_APPUSER_USER=
#DB_APPUSER_PASSWORD=
#DB_READONLY_USER=
#DB_READONLY_PASSWORD=
#DB_ACCTMGR_USER=
#DB_ACCTMGR_PASSWORD=
#DB_APPADMIN_USER=
#DB_APPADMIN_PASSWORD=
#DB_CRUONLY_USER=
#DB_CRUONLY_PASSWORD=

# --- Mail (optional) ---
MAIL_PROTOCOL=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
